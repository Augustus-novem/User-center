# Copy this file to .env and replace every REPLACE_ME value locally.
MYSQL_ROOT_PASSWORD=REPLACE_ME_MYSQL_ROOT_PASSWORD
DB_DSN=root:REPLACE_ME_MYSQL_ROOT_PASSWORD@tcp(mysql8:3306)/user_center?charset=utf8mb4&parseTime=True&loc=Local
JWT_ACCESS_TOKEN_KEY=REPLACE_ME_ACCESS_TOKEN_KEY_AT_LEAST_32_BYTES
JWT_REFRESH_TOKEN_KEY=REPLACE_ME_REFRESH_TOKEN_KEY_AT_LEAST_32_BYTES
WECHAT_STATE_TOKEN_KEY=REPLACE_ME_WECHAT_STATE_KEY
